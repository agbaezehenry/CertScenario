# Lab provider: "containerlab" (real, requires docker + containerlab) or "mock" (dev/CI only)
LAB_PROVIDER=mock

# Where per-session lab workdirs, session records and prober logs live
NORTHSTAR_STATE_DIR=.northstar

# Scenario library root
NORTHSTAR_SCENARIOS_DIR=scenarios

# Resource limits (see spec §7.3)
NORTHSTAR_MAX_NODES=6
NORTHSTAR_IDLE_TIMEOUT_MINUTES=20
NORTHSTAR_SESSION_TIMEOUT_HOURS=4

# Lab exec safety caps (spec §28)
NORTHSTAR_EXEC_TIMEOUT_SECONDS=15
NORTHSTAR_EXEC_MAX_OUTPUT_BYTES=262144

# Prober
NORTHSTAR_PROBER_INTERVAL_SECONDS=1.0

# AI (Phase 4 — not used by Phase 1)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
